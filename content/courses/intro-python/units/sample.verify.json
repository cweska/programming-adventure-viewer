    "first-words/ask-the-traveler": {
      "wrongAnswers": [
        {
          "why": "types the name instead of using the variable",
          "code": [
            "name = input(\"Who goes there? \")",
            "print(\"Welcome to the cabin, Lucky\")"
          ],
          "failsAt": 1,
          "messageContains": "variable"
        }
      ]
    },
    "first-words/barrier-report": {
      "partials": [
        [
          "caster = \"Gearshift\""
        ],
        [
          "caster = \"Gearshift\"",
          "mana = 20"
        ]
      ],
      "wrongAnswers": [
        {
          "why": "puts the number in quotes",
          "code": [
            "caster = \"Gearshift\"",
            "mana = \"20\"",
            "print(caster + \" has \" + mana + \" mana.\")"
          ],
          "failsAt": 2,
          "messageContains": "no quotes"
        },
        {
          "why": "types the sentence instead of using the variables",
          "code": [
            "caster = \"Gearshift\"",
            "mana = 20",
            "print(\"Gearshift has 20 mana.\")"
          ],
          "failsAt": 3,
          "messageContains": "caster"
        },
        {
          "why": "forgets str() and crashes",
          "code": [
            "caster = \"Gearshift\"",
            "mana = 20",
            "print(caster + \" has \" + mana + \" mana.\")"
          ],
          "failsAt": 0,
          "messageContains": "can only concatenate"
        }
      ],
      "notes": "The crash wrong answer (fails_at=0) proves the TypeError path reaches the explainer. The example uses other names (guard, arrows) and another sentence shape, so it cannot be copied as the answer."
    },
